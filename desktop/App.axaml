<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CrossRelay.Desktop.App"
             xmlns:local="using:CrossRelay.Desktop"
             RequestedThemeVariant="Dark">

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/crossrelay-logo.ico"
                      ToolTipText="CrossRelay"
                      Clicked="OnOpenTrayClicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Abrir CrossRelay" Click="OnOpenTrayClicked" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Salir" Click="OnExitTrayClicked" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>

    <Application.Resources>
        <!-- Iconos Vectoriales Exactos en Espacio de Coordenadas SVG viewBox="0 0 24 24" -->
        <StreamGeometry x:Key="IconLogo">M13 17l5-5-5-5 M6 17l5-5-5-5</StreamGeometry>
        <StreamGeometry x:Key="IconSend">M22 2L15 22L11 13L2 9Z M22 2L11 13</StreamGeometry>
        <StreamGeometry x:Key="IconReceive">M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4 M7 10L12 15L17 10 M12 15V3</StreamGeometry>
        <StreamGeometry x:Key="IconDevices">M4 3h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z M8 21h8 M12 17v4</StreamGeometry>
        <StreamGeometry x:Key="IconHistory">M12 2a10 10 0 1 0 0 20 10 10 0 1 0 0-20Z M12 6v6l4 2</StreamGeometry>
        <StreamGeometry x:Key="IconClock">M12 2a10 10 0 1 0 0 20 10 10 0 1 0 0-20Z M12 6v6l4 2</StreamGeometry>
        <StreamGeometry x:Key="IconSettings">M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2Z M12 9a3 3 0 1 0 0 6 3 3 0 1 0 0-6Z</StreamGeometry>
        <StreamGeometry x:Key="IconShield">M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z M9 12l2 2 4-4</StreamGeometry>
        <StreamGeometry x:Key="IconWindows">M0 3.449L9.75 2.1v9.451H0Z M10.949 1.949L24 0v11.4H10.949Z M0 12.6h9.75v9.451L0 20.699Z M10.949 12.6H24V24l-12.9-1.801Z</StreamGeometry>
        <StreamGeometry x:Key="IconCloud">M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242 M12 12v9 M8 16l4-4 4 4</StreamGeometry>
        <StreamGeometry x:Key="IconVideo">M23 7L16 12L23 17V7Z M3 5h11a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z</StreamGeometry>
        <StreamGeometry x:Key="IconImage">M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z M9 7a2 2 0 1 0 0 4 2 2 0 1 0 0-4Z M21 15l-3.1-3.1a2 2 0 0 0-2.8 0L6 21</StreamGeometry>
        <StreamGeometry x:Key="IconArrowUp">M12 19V5 M5 12l7-7 7 7</StreamGeometry>
        <StreamGeometry x:Key="IconArrowDown">M12 5v14 M19 12l-7 7-7-7</StreamGeometry>
        <StreamGeometry x:Key="IconTrash">M3 6h18 M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6 M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2</StreamGeometry>
        <StreamGeometry x:Key="IconTrashSimple">M3 6h18 M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6</StreamGeometry>
        <StreamGeometry x:Key="IconSwap">M16 3l4 4-4 4 M20 7H4 M8 21l-4-4 4-4 M4 17h16</StreamGeometry>
        <StreamGeometry x:Key="IconBatch">M8 3v3a2 2 0 0 1-2 2H3 M21 8h-3a2 2 0 0 1-2-2V3 M16 21v-3a2 2 0 0 1 2-2h3 M3 16h3a2 2 0 0 1 2 2v3</StreamGeometry>
        <StreamGeometry x:Key="IconFolder">M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z</StreamGeometry>
        <StreamGeometry x:Key="IconFile">M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2Z M14 2v6h6</StreamGeometry>
        <StreamGeometry x:Key="IconPause">M6 4h4v16H6Z M14 4h4v16h-4Z</StreamGeometry>
        <StreamGeometry x:Key="IconCross">M18 6L6 18 M6 6l12 12</StreamGeometry>
        <StreamGeometry x:Key="IconBolt">M13 2L3 14h9l-1 8 10-12h-9l1-8Z</StreamGeometry>
        <StreamGeometry x:Key="IconPhone">M7 2h10a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Z M11.9 18h0.2</StreamGeometry>
        <StreamGeometry x:Key="IconPlus">M12 5v14 M5 12h14</StreamGeometry>
        <StreamGeometry x:Key="IconSearch">M11 3a8 8 0 1 0 0 16 8 8 0 1 0 0-16Z M21 21l-4.3-4.3</StreamGeometry>
        <StreamGeometry x:Key="IconChevronDown">M6 9l6 6 6-6</StreamGeometry>
        <StreamGeometry x:Key="IconLinux">M12 2a5 5 0 0 0-5 5v3a5 5 0 0 0 10 0V7a5 5 0 0 0-5-5Zm-7 13c0-3 2-4 3-4h8c1 0 3 1 3 4v4H5v-4Z</StreamGeometry>
        <StreamGeometry x:Key="IconMinimize">M5 12h14</StreamGeometry>
        <StreamGeometry x:Key="IconMaximize">M5 5h14v14H5Z</StreamGeometry>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        
        <!-- Estilo base para iconos vectoriales de trazo en Canvas 24x24 (idéntico a SVG viewBox="0 0 24 24") -->
        <Style Selector="Path.stroke-icon">
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stretch" Value="None" />
        </Style>

        <!-- Botones de Navegación Lateral (Paleta Pure OLED: Structa & Vaultk) -->
        <Style Selector="Button.nav-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#A1A1AA" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <Style Selector="Button.nav-btn Path.stroke-icon">
            <Setter Property="Stroke" Value="#A1A1AA" />
        </Style>

        <Style Selector="Button.nav-btn:pointerover">
            <Setter Property="Background" Value="#131316" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.nav-btn:pointerover Path.stroke-icon">
            <Setter Property="Stroke" Value="#FFFFFF" />
        </Style>

        <!-- Estado Activo: Electric Indigo (#582BF5) de Vaultk / Structa -->
        <Style Selector="Button.nav-btn.active">
            <Setter Property="Background" Value="#582BF5" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.nav-btn.active Path.stroke-icon">
            <Setter Property="Stroke" Value="#FFFFFF" />
        </Style>

        <!-- Botón Primario Electric Indigo (.btn-primary) -->
        <Style Selector="Button.btn-primary">
            <Setter Property="Background" Value="#582BF5" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.btn-primary:pointerover">
            <Setter Property="Background" Value="#4B25E8" />
        </Style>

        <!-- Botón Primario Pill con Degradado Violeta -> Oscuro (.btn-primary-fade) -->
        <Style Selector="Button.btn-primary-fade">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                    <GradientStop Offset="0.0" Color="#5B2EFF" />
                    <GradientStop Offset="0.48" Color="#35198E" />
                    <GradientStop Offset="1.0" Color="#0E0B16" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Button.btn-primary-fade:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                    <GradientStop Offset="0.0" Color="#6B42FF" />
                    <GradientStop Offset="0.52" Color="#4422B2" />
                    <GradientStop Offset="1.0" Color="#151022" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Button.btn-primary-fade:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>

        <!-- Botón Secundario Obsidian (.btn-secondary) -->
        <Style Selector="Button.btn-secondary">
            <Setter Property="Background" Value="#18191E" />
            <Setter Property="BorderBrush" Value="#262B36" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.btn-secondary:pointerover">
            <Setter Property="Background" Value="#23222B" />
            <Setter Property="BorderBrush" Value="#332763" />
        </Style>

        <!-- Input de Texto Estilizado (Vaultk InputBackground #0D0D10 + VaultBorder #23222B) -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#0D0D10" />
            <Setter Property="BorderBrush" Value="#23222B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="#582BF5" />
        </Style>

        <!-- Botones de Control de Ventana Integrados (— □ ✕) -->
        <Style Selector="Button.win-ctrl-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.win-ctrl-btn Path.stroke-icon">
            <Setter Property="Stroke" Value="#71717A" />
            <Setter Property="StrokeThickness" Value="1.8" />
        </Style>
        <Style Selector="Button.win-ctrl-btn:pointerover">
            <Setter Property="Background" Value="#18191E" />
        </Style>
        <Style Selector="Button.win-ctrl-btn:pointerover Path.stroke-icon">
            <Setter Property="Stroke" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.win-ctrl-btn.close:pointerover">
            <Setter Property="Background" Value="#EF4444" />
        </Style>
        <Style Selector="Button.win-ctrl-btn.close:pointerover Path.stroke-icon">
            <Setter Property="Stroke" Value="#FFFFFF" />
        </Style>
    </Application.Styles>
</Application>
