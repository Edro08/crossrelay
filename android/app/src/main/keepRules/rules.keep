# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8

# Go Mobile AAR bindings (JNI callbacks from libgojni.so)
-keep class go.** { *; }
-keep class mobile.** { *; }

# AndroidX Startup & Lifecycle initializers
-keep class * extends androidx.startup.Initializer { *; }
-keep class androidx.lifecycle.ProcessLifecycleInitializer { *; }
